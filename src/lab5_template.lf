target C {
  platform: "RP2040",
  single-threaded: true,
  keepalive: true
}

import Display from "lib/Display.lf"

preamble {=
  #include <hardware/gpio.h>
  #include <hardware/irq.h>
  #include <hardware/sync.h>
  #include <hardware/timer.h>
  #include <pico/stdlib.h>
  #include <stdio.h>
  #include <stdlib.h>
  #define ALARM_NUM 0
=}

main reactor {
  display = new Display()

  preamble {=
    typedef void (*virtual_timer_callback_t)(void);

    typedef struct node_t {
      uint32_t timer_value;  // Absolute deadline in microseconds (lower 32 bits).
      uint32_t timer_id;
      uint32_t repeat_interval;  // 0 for a one-shot timer.
      virtual_timer_callback_t callback;
      struct node_t *next;
    } node_t;

    static node_t* linked_list = NULL;
    static uint32_t next_timer_id = 1;

    void list_insert_sorted(node_t* node) {
      if (linked_list == NULL) {
        node->next = NULL;
        linked_list = node;
      } else if ((int32_t)(linked_list->timer_value - node->timer_value) > 0) {
        node->next = linked_list;
        linked_list = node;
      } else {
        node_t* prev_node = linked_list;
        node_t* curr_node = linked_list->next;
        while (curr_node != NULL && (int32_t)(curr_node->timer_value - node->timer_value) < 0) {
          prev_node = curr_node;
          curr_node = curr_node->next;
        }
        prev_node->next = node;
        node->next = curr_node;
      }
    }

    void list_remove(node_t* node) {
      if (linked_list != NULL) {
        if (linked_list == node) {
          linked_list = linked_list->next;
        } else {
          node_t* prev_node = linked_list;
          node_t* curr_node = linked_list->next;
          while (curr_node != NULL && curr_node != node) {
            prev_node = curr_node;
            curr_node = curr_node->next;
          }
          if (curr_node != NULL) prev_node->next = curr_node->next;
        }
      }
    }

    node_t* list_remove_first() {
      node_t* head = linked_list;
      if (head != NULL) linked_list = head->next;
      return head;
    }

    void arm_next_alarm(void) {
      if (linked_list == NULL) {
        timer_hw->armed = 1u << ALARM_NUM;
        return;
      }
      uint32_t now = timer_hw->timerawl;
      uint32_t deadline = linked_list->timer_value;
      if ((int32_t)(deadline - now) <= 0) deadline = now + 2;
      timer_hw->alarm[ALARM_NUM] = deadline;
    }

    void lab5_timer_irq_handler(void) {
      // INTR is write-one-to-clear (not write-zero-to-clear).
      timer_hw->intr = 1u << ALARM_NUM;

      uint32_t now = timer_hw->timerawl;
      while (linked_list != NULL &&
             (int32_t)(now - linked_list->timer_value) >= 0) {
        node_t* expired = list_remove_first();
        virtual_timer_callback_t cb = expired->callback;

        if (expired->repeat_interval != 0) {
          do {
            expired->timer_value += expired->repeat_interval;
          } while ((int32_t)(now - expired->timer_value) >= 0);
          list_insert_sorted(expired);
        } else {
          free(expired);
        }

        if (cb != NULL) cb();
        now = timer_hw->timerawl;
      }
      arm_next_alarm();
    }

    void virtual_timer_init(void) {
      // Enable alarm 0 in the timer peripheral, register its IRQ handler,

      hw_set_bits(&timer_hw->inte, 1u << ALARM_NUM);
      irq_set_exclusive_handler(TIMER_IRQ_0, lab5_timer_irq_handler);
      irq_set_enabled(TIMER_IRQ_0, true);
    }

    uint32_t virtual_timer_start(uint32_t microseconds,
                                 virtual_timer_callback_t cb) {
      // Use delays less than 2^31 microseconds with the 32-bit counter.
      if (microseconds == 0 || microseconds >= 0x80000000u) return 0;
      node_t* node = malloc(sizeof(node_t));
      if (node == NULL) return 0;

      uint32_t saved = save_and_disable_interrupts();
      node->timer_value = timer_hw->timerawl + microseconds;
      node->timer_id = next_timer_id++;
      if (next_timer_id == 0) next_timer_id = 1;
      node->repeat_interval = 0;
      node->callback = cb;
      node->next = NULL;
      list_insert_sorted(node);
      arm_next_alarm();
      restore_interrupts(saved);
      return node->timer_id;
    }

    uint32_t virtual_timer_start_repeated(uint32_t microseconds,
                                          virtual_timer_callback_t cb) {
      if (microseconds == 0 || microseconds >= 0x80000000u) return 0;
      node_t* node = malloc(sizeof(node_t));
      if (node == NULL) return 0;

      uint32_t saved = save_and_disable_interrupts();
      node->timer_value = timer_hw->timerawl + microseconds;
      node->timer_id = next_timer_id++;
      if (next_timer_id == 0) next_timer_id = 1;
      node->repeat_interval = microseconds;
      node->callback = cb;
      node->next = NULL;
      list_insert_sorted(node);
      arm_next_alarm();
      restore_interrupts(saved);
      return node->timer_id;
    }

    void virtual_timer_cancel(uint32_t time_id) {
      uint32_t saved = save_and_disable_interrupts();
      node_t* node = linked_list;
      while (node != NULL && node->timer_id != time_id) node = node->next;
      if (node != NULL) {
        list_remove(node);
        free(node);
        arm_next_alarm();
      }
      restore_interrupts(saved);
    }

    void led0_toggle(void) {
      gpio_put(PICO_DEFAULT_LED_PIN,
               !gpio_get_out_level(PICO_DEFAULT_LED_PIN));
    }

    void timer_fired(void) {
      printf("Timer Fired!\n");
    }

    void do_nothing(void) {

    }
  =}

  timer print_hw_timer(0, 1000ms)

  reaction(startup) {=
    gpio_init(PICO_DEFAULT_LED_PIN);
    gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_OUT);
    gpio_put(PICO_DEFAULT_LED_PIN, true);

    virtual_timer_init();

    virtual_timer_start_repeated(1000000, led0_toggle);
    virtual_timer_start_repeated(2000000, do_nothing);

    // Uncomment instead to test 9.2.3 independently:
    virtual_timer_start(10000000, timer_fired);
  =}

  reaction(print_hw_timer) -> display.line1 {=
    static char buf[17];
    snprintf(buf, sizeof(buf), "%lu us",
             (unsigned long)timer_hw->timerawl);
    lf_set(display.line1, buf);
  =}
}
